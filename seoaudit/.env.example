# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB
DYNAMO_TABLE_NAME=seo-optimizer

# MongoDB (auth + multi-tenancy)
MONGODB_URI=mongodb://localhost:27017/seo-optimizer
MONGODB_DB_NAME=seo-optimizer

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (login) — DISTINTO de GOOGLE_API_KEY (Gemini)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# LLM (para generación de sugerencias)
GOOGLE_API_KEY=

# Crawler
CRAWLER_CONCURRENCY=5
CRAWLER_TIMEOUT_MS=10000
