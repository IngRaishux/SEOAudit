# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB
DYNAMO_TABLE_NAME=seo-optimizer

# MongoDB (auth + multi-tenancy)
MONGODB_URI=mongodb://localhost:27017/seo-optimizer
MONGODB_DB_NAME=seo-optimizer

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (login) — DISTINTO de GOOGLE_API_KEY (Gemini)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Correo (invitaciones). En desarrollo apunta a Mailpit (docker compose up mailpit).
# Sin SMTP_HOST los correos no se envían: el link de invitación se escribe en consola.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SEOAudit <no-reply@localhost>"

# LLM (para generación de sugerencias)
GOOGLE_API_KEY=

# Crawler (crawl4ai self-hosted)
CRAWLER_CONCURRENCY=5
CRAWLER_TIMEOUT_MS=10000
CRAWL4AI_URL=http://localhost:11235
