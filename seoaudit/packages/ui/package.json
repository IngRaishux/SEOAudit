{
  "name": "@seo-optimizer/ui",
  "version": "1.0.0",
  "description": "Shared UI components for SEO Optimizer applications",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./button": {
      "import": "./dist/components/Button.js"
    },
    "./input": {
      "import": "./dist/components/Input.js"
    },
    "./dialog": {
      "import": "./dist/components/Dialog.js"
    },
    "./back-button": {
      "import": "./dist/components/BackButton.js"
    },
    "./session-provider": {
      "import": "./dist/components/SessionProvider.js"
    },
    "./toast": {
      "import": "./dist/components/Toast.js"
    },
    "./toaster": {
      "import": "./dist/components/Toaster.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "react": "^19.2.4",
    "next-auth": "^4.24.0",
    "next": "^16.2.5",
    "@radix-ui/react-toast": "^1.2.23",
    "@remixicon/react": "^4.9.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/react": "^19.2.4",
    "@types/node": "^20.0.0"
  }
}
